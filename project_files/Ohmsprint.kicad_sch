	(text "Pametno je groundovati ova\ndva pina jer mogu da \npokupe i najmanji sum"
		(exclude_from_sim no)
		(at 167.64 119.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a8df080f-0af8-452a-8256-164900a5152f")
	)
	(text "Mozda nam ni ne treba LDO, moramo se dogovoriti, i \ndalje nisam siguran da li buck ima dovoljno mali noise"
		(exclude_from_sim no)
		(at 152.4 52.07 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ab197fa8-43a2-47b7-bf51-86114c3e18ca")
	)
	(text "Ovo je rectifier\n"
		(exclude_from_sim no)
		(at 48.26 35.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "b4a53c37-9a3a-4023-8d39-21ec27bc307f")
	)
	(text "Ovo nisam siguran dal sam dobro \nispovezivao, ovi pinovi 3 su \nsamo metalni switchevi koji ne \nrade nista kad je konektovano"
		(exclude_from_sim no)
		(at 39.37 154.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c1db63c5-f263-45d2-92c9-c124381cbfbf")
	)
	(text "Viskovi"
