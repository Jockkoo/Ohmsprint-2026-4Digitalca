				(size 1.27 1.27)
			)
		)
		(uuid "e6be2fad-9e6d-4945-bbe1-e323e6611ad6")
	)
	(text "0-420mV\n"
		(exclude_from_sim no)
		(at 120.65 135.89 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e6dc0f36-348e-4b67-bab4-a2f14eb88491")
	)
	(text "Moramo imati buck konvertor jer je jedini nacin da vucemo \npreko 1A, a da ne zapalimo LDO. Cilj je da 4V iz buck-a dovedemo \nna LDO koji ce izbaciti stabilnih 3.3V \nbez switching noise koji bi smetao mernom chipu"
		(exclude_from_sim no)
		(at 246.38 26.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
